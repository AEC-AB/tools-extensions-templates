<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ExtensionId>RevitAppExtension</ExtensionId>
    <Authors>AEC AB</Authors>
    <Version>0.0.1</Version>
    <Title>RevitAppExtension</Title>
    <Description>RevitAppExtension Description</Description>
    <PackageTags>Revit;Assistant;Extension;App</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageIconUrl></PackageIconUrl>
    <!-- 
Adjust MainRevitVersion to get IntelliSense for the correct version do a 
dotnet restore to restore the correct nuget packages for the selected Revit version.
-->
<MainRevitVersion Condition="'$(Configuration)' == 'Debug'">2024</MainRevitVersion>
    <MainRevitVersion Condition="'$(Configuration)' == 'Design'">2025</MainRevitVersion>
    <RevitNet8TargetFramework>net8.0-windows7.0</RevitNet8TargetFramework>
    <RevitPlatformBuildDir>$(MSBuildThisFileDirectory)../../platforms/RevitPlatform/build/</RevitPlatformBuildDir>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <Import Project="$(RevitPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Revit.props" Condition="Exists('$(RevitPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Revit.props')" />

  <ItemGroup Condition="!Exists('$(RevitPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Revit.props')">
    <PackageReference Include="CW.Assistant.Extensions.Templates.Platform.Revit" Version="26.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <Configurations>Debug;Design;Design 2024;$(Configurations)</Configurations>
    <UseWPF>true</UseWPF>
    <RevitAppFrameworkPackageVersion Condition="'$(RevitAppFrameworkPackageVersion)' == ''">1.*</RevitAppFrameworkPackageVersion>
  </PropertyGroup>

  <Choose>
    <When Condition="$(Configuration.Contains('Design'))">
      <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <XamlDebuggingInformation>True</XamlDebuggingInformation>
        <AssemblyName>$(ExtensionId)</AssemblyName>
        <OutputPath>./bin/Design/</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
      </PropertyGroup>
    </When>
    <Otherwise>
      <!-- For library mode, exclude App.xaml entirely -->
      <PropertyGroup>
        <OutputType>Library</OutputType>
      </PropertyGroup>
      <ItemGroup>
        <ApplicationDefinition Remove="App.xaml" />
        <Page Remove="App.xaml" />
        <Compile Remove="App.xaml.cs" />
        <None Include="App.xaml" />
        <None Include="App.xaml.cs" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <None Include="Icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <Choose>
    <When Condition="'$(TargetFramework)' == 'net48'">
      <ItemGroup>
        <Reference Include="WindowsBase" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="2.2.0" PrivateAssets="all" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" PrivateAssets="all" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <PackageReference Include="CW.RevitAppFramework.$(MainRevitVersion)" Version="$(RevitAppFrameworkPackageVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="RevitSeparationAnalyzer" Version="1.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MVVMFluent.WPF" Version="0.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile; runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="WPF-UI" Version="4.0.2" />
  </ItemGroup>

  <Import Project="$(RevitPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Revit.targets" Condition="Exists('$(RevitPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Revit.targets')" />
</Project>
