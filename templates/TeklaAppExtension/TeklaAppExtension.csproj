<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ExtensionId>TeklaAppExtension</ExtensionId>
<Authors>AEC AB</Authors>
    <Version>0.0.1</Version>
    <Title>TeklaAppExtension</Title>
    <Description>TeklaAppExtension Description</Description>
    <PackageTags>Tekla;Assistant;Extension;App</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageIconUrl></PackageIconUrl>
<MainTeklaVersion Condition="'$(Configuration)' == 'Debug'">2024</MainTeklaVersion>
    <MainTeklaVersion Condition="'$(Configuration)' == 'Design'">2023</MainTeklaVersion>
    <TeklaPlatformBuildDir>$(MSBuildThisFileDirectory)../../platforms/TeklaPlatform/build/</TeklaPlatformBuildDir>
    <!-- 
Adjust MainTeklaVersion to get IntelliSense for the correct version do a 
dotnet restore to restore the correct nuget packages for the selected Tekla version.
-->
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <Import Project="$(TeklaPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Tekla.props" Condition="Exists('$(TeklaPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Tekla.props')" />

  <ItemGroup Condition="!Exists('$(TeklaPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Tekla.props')">
    <PackageReference Include="CW.Assistant.Extensions.Templates.Platform.Tekla" Version="26.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <Configurations>Debug;Design;$(Configurations)</Configurations>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

<Choose>
<When Condition="'$(Configuration)' == 'Design'">
<PropertyGroup>
<OutputType>WinExe</OutputType>
<XamlDebuggingInformation>True</XamlDebuggingInformation>
<AssemblyName>$(ExtensionId)</AssemblyName>
                <OutputPath>./bin/Design/</OutputPath>
                <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
</PropertyGroup>
</When>
<Otherwise>
<!-- For library mode, exclude App.xaml entirely -->
<PropertyGroup>
<OutputType>Library</OutputType>
</PropertyGroup>
<ItemGroup>
<ApplicationDefinition Remove="App.xaml" />
<Page Remove="App.xaml" />
<Compile Remove="App.xaml.cs" />
<None Include="App.xaml">
  <Generator>MSBuild:Compile</Generator>
</None>
<None Include="App.xaml.cs" />
</ItemGroup>
</Otherwise>
</Choose>

  <Choose>
    <When Condition="'$(TargetFramework)' == 'net48'">
      <ItemGroup>
        <Reference Include="PresentationCore" />
        <Reference Include="PresentationFramework" />
        <Reference Include="WindowsBase" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="2.2.0" PrivateAssets="all" />
      </ItemGroup>
    </When>
  </Choose>

  <ItemGroup>
    <None Include="Icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml" />
    <PackageReference Include="MVVMFluent.WPF" Version="0.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile; runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="WPF-UI" Version="4.*" />
  </ItemGroup>

  <Import Project="$(TeklaPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Tekla.targets" Condition="Exists('$(TeklaPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Tekla.targets')" />
</Project>
