<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ExtensionId>AssistantAutomationExtension</ExtensionId>
    <Authors>AEC AB</Authors>
    <Version>0.0.1</Version>
    <Title>AssistantAutomationExtension</Title>
    <Description>AssistantAutomationExtension Description</Description>
    <PackageTags>AssistantExtension;Assistant;Extension</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageIconUrl></PackageIconUrl>
    <AssistantPlatformBuildDir>$(MSBuildThisFileDirectory)../../platforms/AssistantPlatform/build/</AssistantPlatformBuildDir>
  </PropertyGroup>

  <Import Project="$(AssistantPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Assistant.props" Condition="Exists('$(AssistantPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Assistant.props')" />

  <ItemGroup Condition="!Exists('$(AssistantPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Assistant.props')">
    <PackageReference Include="CW.Assistant.Extensions.Templates.Platform.Assistant" Version="26.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <Import Project="$(AssistantPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Assistant.targets" Condition="Exists('$(AssistantPlatformBuildDir)CW.Assistant.Extensions.Templates.Platform.Assistant.targets')" />
</Project>
