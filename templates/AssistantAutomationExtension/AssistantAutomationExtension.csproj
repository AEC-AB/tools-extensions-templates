<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ExtensionId>AssistantAutomationExtension</ExtensionId>
    <Authors>AEC AB</Authors>
    <Version>26.0.0</Version>
    <Title>AssistantAutomationExtension</Title>
    <Description>AssistantAutomationExtension Description</Description>
    <PackageTags>AssistantExtension;Assistant;Extension</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageIconUrl></PackageIconUrl>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <DebugType>portable</DebugType>
    <NoWarn>NU1701</NoWarn>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CW.Assistant.Extensions.Assistant" Version="26.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
