<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>CW.Assistant.Extensions.Templates.Platform.Revit</PackageId>
    <Version>26.0.0</Version>
    <Title>Revit template platform configuration</Title>
    <Authors>AEC AB</Authors>
    <Description>Centralized build configuration for Revit extension templates.</Description>
    <PackageTags>Assistant;Extension;Template;Revit;Platform</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**/*" />
    <None Include="build/**/*" Pack="true" PackagePath="build/" />
  </ItemGroup>
</Project>
